<?xml version="1.0" ?>
<robot name="parallel_jaw_gripper">

  <material name="anodized_black">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="aluminum">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="dark_steel">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="rubber">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="sensor_green">
    <color rgba="0.10 0.30 0.15 1.0"/>
  </material>

  <!-- Mounting plate -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/mounting_plate.stl"/></geometry>
      <material name="dark_steel"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>

  <!-- Housing -->
  <link name="housing_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/housing.stl"/></geometry>
      <material name="anodized_black"/>
    </visual>
    <inertial><mass value="0.12"/><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/></inertial>
  </link>
  <joint name="housing_mount" type="fixed">
    <parent link="base_link"/><child link="housing_link"/>
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
  </joint>

  <!-- Actuator -->
  <link name="actuator_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/actuator.stl"/></geometry>
      <material name="dark_steel"/>
    </visual>
    <inertial><mass value="0.04"/><inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/></inertial>
  </link>
  <joint name="actuator_mount" type="fixed">
    <parent link="housing_link"/><child link="actuator_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Left finger base -->
  <link name="finger_base_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_base_left.stl"/></geometry>
      <material name="aluminum"/>
    </visual>
    <inertial><mass value="0.02"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial>
  </link>
  <joint name="finger_left_slide" type="prismatic">
    <parent link="housing_link"/><child link="finger_base_left_link"/>
    <origin xyz="-0.018 -0.020 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.025" upper="0" effort="5" velocity="0.1"/>
  </joint>

  <!-- Left finger tip -->
  <link name="finger_tip_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_tip_left.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <inertial><mass value="0.008"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
  </link>
  <joint name="finger_tip_left_mount" type="fixed">
    <parent link="finger_base_left_link"/><child link="finger_tip_left_link"/>
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
  </joint>

  <!-- Left force sensor -->
  <link name="force_sensor_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/force_sensor_left.stl"/></geometry>
      <material name="sensor_green"/>
    </visual>
    <inertial><mass value="0.003"/><inertia ixx="0.0000005" ixy="0" ixz="0" iyy="0.0000005" iyz="0" izz="0.0000005"/></inertial>
  </link>
  <joint name="force_sensor_left_mount" type="fixed">
    <parent link="finger_tip_left_link"/><child link="force_sensor_left_link"/>
    <origin xyz="0.006 -0.005 0" rpy="0 0 0"/>
  </joint>

  <!-- Right finger base -->
  <link name="finger_base_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_base_right.stl"/></geometry>
      <material name="aluminum"/>
    </visual>
    <inertial><mass value="0.02"/><inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/></inertial>
  </link>
  <joint name="finger_right_slide" type="prismatic">
    <parent link="housing_link"/><child link="finger_base_right_link"/>
    <origin xyz="0.018 -0.020 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.025" effort="5" velocity="0.1"/>
    <mimic joint="finger_left_slide" multiplier="-1"/>
  </joint>

  <!-- Right finger tip -->
  <link name="finger_tip_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_tip_right.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <inertial><mass value="0.008"/><inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/></inertial>
  </link>
  <joint name="finger_tip_right_mount" type="fixed">
    <parent link="finger_base_right_link"/><child link="finger_tip_right_link"/>
    <origin xyz="0 -0.025 0" rpy="0 0 0"/>
  </joint>

  <!-- Right force sensor -->
  <link name="force_sensor_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/force_sensor_right.stl"/></geometry>
      <material name="sensor_green"/>
    </visual>
    <inertial><mass value="0.003"/><inertia ixx="0.0000005" ixy="0" ixz="0" iyy="0.0000005" iyz="0" izz="0.0000005"/></inertial>
  </link>
  <joint name="force_sensor_right_mount" type="fixed">
    <parent link="finger_tip_right_link"/><child link="force_sensor_right_link"/>
    <origin xyz="-0.006 -0.005 0" rpy="0 0 0"/>
  </joint>

</robot>
