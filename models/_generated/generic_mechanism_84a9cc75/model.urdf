<?xml version="1.0" ?>
<robot name="generic_mechanism_84a9cc75">

  <material name="black_anodized">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>
  <material name="dark_metal">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>
  <material name="aluminum">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="servo_blue">
    <color rgba="0.10 0.12 0.20 1.0"/>
  </material>
  <material name="pcb_green">
    <color rgba="0.05 0.30 0.12 1.0"/>
  </material>
  <material name="rubber_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="carbon_fiber">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>
  <material name="battery_blue">
    <color rgba="0.12 0.18 0.35 1.0"/>
  </material>
  <material name="clear">
    <color rgba="0.80 0.80 0.82 1.0"/>
  </material>
  <material name="red_wire">
    <color rgba="0.70 0.10 0.10 1.0"/>
  </material>
  <material name="yellow">
    <color rgba="0.80 0.70 0.10 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/base.stl"/></geometry>
      <material name="black_anodized"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="main_body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/main_body.stl"/></geometry>
      <material name="black_anodized"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="main_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="main_body_link"/>
    <origin xyz="0 0.0150 0" rpy="0 0 0"/>
  </joint>

  <link name="actuator_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/actuator.stl"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="actuator_joint" type="revolute">
    <parent link="main_body_link"/>
    <child link="actuator_link"/>
    <origin xyz="0 0.0250 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <link name="arm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/arm.stl"/></geometry>
      <material name="aluminum"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="arm_joint" type="revolute">
    <parent link="actuator_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0.0250 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <link name="end_effector_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/end_effector.stl"/></geometry>
      <material name="aluminum"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="end_effector_joint" type="fixed">
    <parent link="arm_link"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0.0150 0" rpy="0 0 0"/>
  </joint>

  <link name="controller_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/controller.stl"/></geometry>
      <material name="pcb_green"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="controller_joint" type="fixed">
    <parent link="end_effector_link"/>
    <child link="controller_link"/>
    <origin xyz="0 0.0150 0" rpy="0 0 0"/>
  </joint>

  <link name="sensor_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/sensor.stl"/></geometry>
      <material name="dark_metal"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="sensor_joint" type="fixed">
    <parent link="controller_link"/>
    <child link="sensor_link"/>
    <origin xyz="0 0.0150 0" rpy="0 0 0"/>
  </joint>

</robot>